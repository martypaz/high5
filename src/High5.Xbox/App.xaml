<Application x:Class="High5.Xbox.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="TileBrush" Color="#FF1E2A3A"/>
        <Style x:Key="TileText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/><Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- Focusable poster tile; ImageUrl may be empty (demo data) so the title is always shown. -->
        <DataTemplate x:Key="TileTemplate">
            <Grid Width="260" Height="170" Background="{StaticResource TileBrush}" Padding="12">
                <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"/>
                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource TileText}"/>
                    <TextBlock Text="{Binding Genre}" Opacity="0.7"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Application.Resources>
</Application>
