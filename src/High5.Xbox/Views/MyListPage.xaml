<Page x:Class="High5.Xbox.Views.MyListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="48,24" XYFocusKeyboardNavigation="Enabled">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="My List" FontSize="48"/>
        <GridView Grid.Row="1" ItemsSource="{x:Bind Vm.Items}" ItemTemplate="{StaticResource TileTemplate}" IsItemClickEnabled="True"
                  ItemClick="OnTile" SelectionMode="None" Margin="0,16,0,0"/>
    </Grid>
</Page>
