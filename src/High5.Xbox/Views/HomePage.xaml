<Page x:Class="High5.Xbox.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:High5.Core.Models">
    <ScrollViewer VerticalScrollBarVisibility="Hidden" XYFocusKeyboardNavigation="Enabled">
        <StackPanel Margin="48,24,48,48" Spacing="24">
            <ProgressRing IsActive="{x:Bind Vm.IsLoading, Mode=OneWay}" Width="64" Height="64"/>
            <TextBlock Text="{x:Bind Vm.Error, Mode=OneWay}" Foreground="OrangeRed"/>

            <TextBlock Text="Continue watching" FontSize="32" Visibility="{x:Bind HasResume, Mode=OneWay}"/>
            <ListView ItemsSource="{x:Bind Vm.ContinueWatching}" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                      ScrollViewer.VerticalScrollMode="Disabled" IsItemClickEnabled="True" ItemClick="OnResumeClick" SelectionMode="None">
                <ListView.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="16"/></ItemsPanelTemplate></ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="260" Height="170" Background="{StaticResource TileBrush}" Padding="12">
                            <TextBlock Text="{Binding Caption}" Style="{StaticResource TileText}" VerticalAlignment="Bottom"/>
                            <ProgressBar Value="{Binding Point.Progress}" Maximum="1" VerticalAlignment="Bottom" Margin="0,0,0,-12"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ItemsControl ItemsSource="{x:Bind Vm.Rails}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="m:Rail">
                        <StackPanel Margin="0,0,0,24">
                            <TextBlock Text="{x:Bind Title}" FontSize="32" Margin="0,0,0,8"/>
                            <ListView ItemsSource="{x:Bind Items}" ItemTemplate="{StaticResource TileTemplate}" SelectionMode="None"
                                      IsItemClickEnabled="True" ItemClick="OnTileClick" ScrollViewer.HorizontalScrollMode="Enabled"
                                      ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollMode="Disabled">
                                <ListView.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="16"/></ItemsPanelTemplate></ListView.ItemsPanel>
                            </ListView>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
