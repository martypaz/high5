<Page x:Class="High5.Xbox.Views.GuidePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="using:High5.Core.ViewModels">
    <Grid Margin="48,24" XYFocusKeyboardNavigation="Enabled">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="TV guide" FontSize="48"/>
        <ListView Grid.Row="1" ItemsSource="{x:Bind Vm.Rows}" IsItemClickEnabled="True" ItemClick="OnRow" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:GuideRow">
                    <Grid Padding="0,12" ColumnSpacing="24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Channel.Name}" FontSize="30"/>
                        <StackPanel Grid.Column="1"><TextBlock Text="Now" Opacity="0.6"/><TextBlock Text="{x:Bind OnNow.Title}" FontSize="26"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Next" Opacity="0.6"/><TextBlock Text="{x:Bind Next.Title}" FontSize="26"/></StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
