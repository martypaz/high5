<Page x:Class="High5.Xbox.Views.ShowPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:m="using:High5.Core.Models">
    <Grid Margin="48,24" XYFocusKeyboardNavigation="Enabled">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <TextBlock Text="{x:Bind Vm.Show.Title, Mode=OneWay}" FontSize="48"/>
            <TextBlock Text="{x:Bind Vm.Show.Synopsis, Mode=OneWay}" FontSize="22" TextWrapping="Wrap" MaxWidth="1100"/>
            <TextBlock Text="{x:Bind Vm.Error, Mode=OneWay}" Foreground="OrangeRed"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16" Margin="0,16">
            <Button x:Name="PlayButton" Content="Play" FontSize="26" Click="OnPlay"/>
            <Button Content="{x:Bind MyListLabel, Mode=OneWay}" FontSize="26" Command="{x:Bind Vm.ToggleMyList}"/>
            <ComboBox ItemsSource="{x:Bind Vm.Seasons, Mode=OneWay}" SelectedItem="{x:Bind Vm.SelectedSeason, Mode=TwoWay}" Header="Series" FontSize="22"/>
        </StackPanel>
        <ListView Grid.Row="2" ItemsSource="{x:Bind Vm.Episodes, Mode=OneWay}" IsItemClickEnabled="True" ItemClick="OnEpisode" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:Episode">
                    <StackPanel Padding="0,8">
                        <TextBlock FontSize="26"><Run Text="{x:Bind EpisodeNumber}"/><Run Text=". "/><Run Text="{x:Bind Title}"/></TextBlock>
                        <TextBlock Text="{x:Bind Synopsis}" Opacity="0.7" FontSize="18"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
