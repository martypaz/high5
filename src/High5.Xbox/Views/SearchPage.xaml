<Page x:Class="High5.Xbox.Views.SearchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="48,24" XYFocusKeyboardNavigation="Enabled">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <!-- Selecting the box on Xbox opens the system on-screen keyboard. -->
        <AutoSuggestBox x:Name="Box" PlaceholderText="Search shows and genres" FontSize="26" QueryIcon="Find" QuerySubmitted="OnQuery" TextChanged="OnText"/>
        <GridView Grid.Row="1" ItemsSource="{x:Bind Vm.Results}" ItemTemplate="{StaticResource TileTemplate}" Margin="0,16,0,0"
                  IsItemClickEnabled="True" ItemClick="OnTile" SelectionMode="None"/>
    </Grid>
</Page>
