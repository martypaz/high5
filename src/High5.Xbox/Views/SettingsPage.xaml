<Page x:Class="High5.Xbox.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="48,24" Spacing="16" MaxWidth="700" HorizontalAlignment="Left" XYFocusKeyboardNavigation="Enabled">
        <TextBlock Text="Settings" FontSize="48"/>
        <TextBlock Text="Parental controls" FontSize="30"/>
        <PasswordBox x:Name="Pin" Header="4-digit PIN" MaxLength="4" FontSize="24"/>
        <ComboBox x:Name="Rating" Header="Maximum age rating" FontSize="24" SelectionChanged="OnRating"/>
        <Button Content="Set PIN" FontSize="24" Click="OnSetPin"/>
        <TextBlock x:Name="Status" Opacity="0.8" FontSize="20"/>
        <Button Content="Sign out" FontSize="24" Click="OnSignOut"/>
    </StackPanel>
</Page>
