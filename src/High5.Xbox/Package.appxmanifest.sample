<?xml version="1.0" encoding="utf-8"?>
<!-- Sample only: Visual Studio generates the real Package.appxmanifest when you create the UWP project.
     Make sure it contains these Xbox-relevant bits. -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         IgnorableNamespaces="uap mp">
  <Identity Name="High5.PersonalUse" Publisher="CN=You" Version="0.1.0.0"/>
  <Properties>
    <DisplayName>High5</DisplayName><PublisherDisplayName>You</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <!-- Xbox runs the Windows.Universal family. 17763 (1809) or later. -->
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0"/>
  </Dependencies>
  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="High5.Xbox.App">
      <uap:VisualElements DisplayName="High5" Description="Personal-use client" BackgroundColor="#0B1320"
                          Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile/>
        <uap:SplashScreen Image="Assets\SplashScreen.png"/>
      </uap:VisualElements>
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClient"/>
  </Capabilities>
</Package>
